# Backend API base URL (required for production builds)
# e.g. VITE_API_BASE_URL="https://api-bisa-nota.vercel.app"
# Local dev: VITE_API_BASE_URL="http://localhost:5001"
#
# Production notes:
# - A production build FAILS unless VITE_API_BASE_URL points to a real
#   deployment (localhost/127.0.0.1 values are rejected) — see vite.config.ts.
# - Set it in CI (the build job) and in Vercel project environment variables;
#   do NOT paste secrets or localhost URLs into tracked files.
VITE_API_BASE_URL=